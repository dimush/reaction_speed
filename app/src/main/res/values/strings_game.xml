<?xml version="1.0" encoding="utf-8"?>
<!--
  Strings drawn on the game playfield by GameView. English only for now; translations follow.
-->
<resources>

    <!-- HUD progress, e.g. "3 / 10": %1$d = current attempt, %2$d = attempts in the series. -->
    <string name="game_progress_format">%1$d / %2$d</string>

    <!-- Reaction time floating up from the hit point, e.g. "231 ms". %1$d = milliseconds. -->
    <string name="game_reaction_ms_format">%1$d ms</string>

    <!-- Shown briefly when the player taps before the target appeared. -->
    <string name="game_false_start">Too early!</string>

</resources>
