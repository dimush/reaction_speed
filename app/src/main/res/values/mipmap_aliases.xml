<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Legacy fallback for API 23-25, which cannot resolve mipmap-anydpi-v26/ic_launcher.xml
      (adaptive-icon requires API 26+). These aliases point plain @mipmap/ic_launcher and
      @mipmap/ic_launcher_round references at flat vector drawables instead. On API 26+ the
      v26 adaptive-icon XML in mipmap-anydpi-v26/ takes precedence over this default-config alias.
    -->
    <item name="ic_launcher" type="mipmap">@drawable/ic_launcher_legacy</item>
    <item name="ic_launcher_round" type="mipmap">@drawable/ic_launcher_legacy_round</item>
</resources>
