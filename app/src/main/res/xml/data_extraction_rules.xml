<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (android:dataExtractionRules). Same policy as backup_rules.xml: the results and
  settings file travels with cloud backup and device-to-device transfer, nothing else does.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="reaction_speed.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="reaction_speed.xml" />
    </device-transfer>
</data-extraction-rules>
